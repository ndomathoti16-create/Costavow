# Application behavior
APP_ENV=development
LOG_LEVEL=INFO

# Local persistence. Relative paths are resolved from the repository root.
DATA_DIR=./data
DB_PATH=./data/metrora.duckdb
MAX_UPLOAD_MB=200

# AI is disabled by default. The deterministic summary works without a provider.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Optional AWS storage/query settings. Authentication uses the normal AWS credential chain.
AWS_REGION=us-east-1
S3_BUCKET=
ATHENA_DATABASE=
ATHENA_OUTPUT_LOCATION=

# Enable only for a trusted local workspace (legacy METRORA_DESKTOP also works).
# COSTAVOW_DESKTOP=1
# Optional native desktop storage override (legacy METRORA_USER_DATA_DIR also works).
# COSTAVOW_USER_DATA_DIR=/path/to/private/workspace
